# ---- Geral ----
PORT=3333
NODE_ENV=development
# URL pública do BFF (sem barra final). Usada em links absolutos, ex.: imagens em /static.
# Padrão: http://localhost:${PORT}. Em um emulador/dispositivo físico use o IP da máquina.
PUBLIC_BASE_URL=http://localhost:3333
# fake (padrão, tudo em memória) | real (integrações de verdade)
ADAPTERS=fake
# Origens permitidas no CORS, separadas por vírgula. Vazio = CORS desligado.
CORS_ORIGINS=
# Desativa rate limit (apenas para testes)
THROTTLE_DISABLED=false

# ---- Auth ----
JWT_SECRET=troque-este-segredo-em-producao
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ---- Banco próprio do BFF (opcional; sem DATABASE_URL usa memória) ----
# DATABASE_URL=postgresql://prime:prime@localhost:5432/caffeine_prime_bff

# ---- Webhooks ----
VINDI_WEBHOOK_SECRET=dev-secret
FREIGHT_SERVICE_ACCESS_TOKEN=dev-freight-token

# ---- Vindi (chave pública vai para o app via GET /payments/vindi-config) ----
VINDI_PUBLIC_KEY=
VINDI_API_URL=https://sandbox-app.vindi.com.br/api/v1
VINDI_SANDBOX=true
VINDI_API_KEY=

# ---- Prime API ----
PRIME_API_URL=
CAFFEINE_PRIME_X_API_KEY=

# ---- Shopify ----
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_MULTIPASS_CLOUD_FUNCTION_URL=
SHOPIFY_MULTIPASS_SECRET=
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
SENDGRID_API_KEY=
MAGIC_LINK_BASE_URL=caffeineprime://auth/magic

# ---- Intelipost ----
INTELIPOST_API_URL=https://api.intelipost.com.br/api/v1
INTELIPOST_API_KEY=

# ---- Caffeine X ----
CAFFEINE_X_BASE_URL=
CAFFEINE_X_API_KEY=

# ---- Push: Expo (app RN) e FCM/APNs via Firebase (app Flutter) ----
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=
# JSON inteiro da service account do Firebase (FcmPushSender; firebase-admin ainda não instalado)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Lembretes da rotina (varredura por minuto no processo HTTP; em produção mover para worker)
REMINDERS_ENABLED=true

# ---- Frentes 2 e 5: feature flags e versões dos termos de consentimento (LGPD) ----
FEATURE_ROUTINE=true
FEATURE_HEALTH=true
FEATURE_ASSISTANT=true
# Mudar a versão obriga o app a pedir o consentimento de novo
CONSENT_VERSION_PUSH=2026-10-11
CONSENT_VERSION_HEALTH_DATA=2026-10-11
CONSENT_VERSION_ROUTINE_DATA=2026-10-11
CONSENT_VERSION_AI_ASSISTANT=2026-10-11
CONSENT_VERSION_ANALYTICS=2026-10-11

# ---- Prime IA (ADAPTERS=real usa a API da Anthropic; fake responde por palavra-chave) ----
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-4-5
ASSISTANT_MAX_TOKENS=700
ASSISTANT_DAILY_MESSAGE_LIMIT=30

# ---- Links do app (GET /config) ----
APP_MIN_SUPPORTED_VERSION=1.0.0
LINK_PRIVACY=https://www.caffeinearmy.com.br/politica-de-privacidade
LINK_TERMS=https://www.caffeinearmy.com.br/termos-de-uso
LINK_SUPPORT=https://www.caffeinearmy.com.br/atendimento
LINK_SUBSCRIBE=https://www.caffeinearmy.com.br/prime
LINK_HEALTH_PRIVACY=https://www.caffeinearmy.com.br/politica-de-privacidade#saude
